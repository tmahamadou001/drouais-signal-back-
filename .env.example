# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Serveur
PORT=3001
NODE_ENV=production

# Frontend (autorisé en CORS)
CLIENT_URL=https://onsignale.fr

# Tenant par défaut en développement
DEV_TENANT_SLUG=dreux

# Resend (emails)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@onsignale.fr

# Origine publique des images des e-mails (logo). Surtout pas CLIENT_URL :
# en dev il vaut http://localhost:5173, que nul client mail ne peut atteindre.
EMAIL_ASSET_URL=https://onsignale.fr

# Supervision des erreurs (Sentry). Absent : rien n'est envoyé, le serveur
# fonctionne à l'identique et les erreurs restent dans les journaux.
# Le DSN est public par construction (il voyage dans l'app et le bundle web) —
# c'est le jeton d'authentification `SENTRY_AUTH_TOKEN`, lui, qui est secret et
# qui n'a rien à faire ici : il ne sert qu'au build.
SENTRY_DSN=https://xxxx@xxxx.ingest.de.sentry.io/xxxx
SENTRY_ENVIRONMENT=production
# Zéro par défaut : les traces de performance consommeraient le quota réservé
# aux erreurs. À relever ponctuellement pour chercher une lenteur.
SENTRY_TRACES_SAMPLE_RATE=0
